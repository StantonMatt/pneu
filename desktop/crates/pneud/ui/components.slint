// Pneu's own controls, shared by every page of the window.
import { Pneu, Tone, Icons, WindowFocus } from "theme.slint";

// Keyboard and accessibility actions share the same modal boundary.
export global Interaction { in-out property <bool> modal-open; }

// A link is a quiet accent-coloured action, such as "Can't connect?".
export enum ButtonKind { neutral, danger, row, primary, tonal, link }

// Keyboard focus shows a ring; pointer focus doesn't.
component FocusTarget inherits FocusScope {
    in property <bool> active: true;
    in-out property <bool> ring;
    callback activate();
    enabled: active;
    changed active => { if !self.active { self.ring = false; } }
    focus-gained(reason) => {
        WindowFocus.changed(true);
        self.ring = reason == FocusReason.tab-navigation || reason == FocusReason.popup-activation;
    }
    focus-lost(reason) => {
        if reason == FocusReason.window-activation { WindowFocus.changed(false); }
        self.ring = false;
    }
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " { self.activate(); return accept; }
        return reject;
    }
    // In-window dialogs do not get Slint's native popup focus event.
    public function focus-popup() {
        self.focus();
        self.focus-gained(FocusReason.popup-activation);
    }
}

export component PneuButton inherits Rectangle {
    in property <bool> dialog-control;
    private property <bool> interactive: !Interaction.modal-open || dialog-control;
    in property <string> text;
    in property <image> icon;
    in property <length> icon-size: 16px;
    in property <length> font-size <=> label.font-size;
    in property <ButtonKind> kind: neutral;
    in property <bool> enabled: true;
    in property <bool> wide;
    // Popups focus their default button once shown; focusing during layout recurses.
    in property <bool> autofocus;
    in property <string> focus-key;
    changed focus-key => { if root.autofocus { focus-timer.running = true; } }
    callback clicked();
    private property <bool> is-row: kind == ButtonKind.row;
    private property <bool> is-link: kind == ButtonKind.link;
    private property <length> inset: is-link ? 8px : 14px;
    min-width: content.preferred-width + 2 * inset;
    max-width: is-row || wide ? 10000px : self.min-width;
    horizontal-stretch: is-row || wide ? 1 : 0;
    min-height: is-row ? 44px : is-link ? 24px : 30px;
    max-height: self.min-height;
    border-radius: is-row ? 0px : 8px;
    background: is-row ? (touch.pressed ? Pneu.button : transparent)
        : is-link ? transparent
        : kind == ButtonKind.danger ? Pneu.danger-fill
        : kind == ButtonKind.primary ? Pneu.accent
        : kind == ButtonKind.tonal ? Pneu.accent-soft : Pneu.button;
    border-width: kind == ButtonKind.neutral || fs.ring ? 1px : 0px;
    border-color: fs.ring ? Pneu.accent : Pneu.button-border;
    opacity: enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-enabled: root.enabled && root.interactive;
    accessible-label: text;
    accessible-action-default => { if root.enabled && root.interactive { root.clicked(); } }
    forward-focus: fs;
    public function focus-popup() { fs.focus-popup(); }
    focus-timer := Timer {
        interval: 1ms; running: root.autofocus;
        triggered => { self.running = false; fs.focus-popup(); }
    }
    if fs.ring: Rectangle {
        x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px;
        border-radius: root.is-row ? 2px : 10px;
        border-width: 2px; border-color: Pneu.focus-ring;
    }
    Rectangle {
        border-radius: parent.border-radius;
        background: !root.enabled ? transparent : touch.pressed ? Pneu.pressed : touch.has-hover ? Pneu.hover : transparent;
    }
    content := HorizontalLayout {
        x: root.inset; width: parent.width - 2 * root.inset; height: parent.height;
        alignment: root.is-row ? start : center;
        spacing: 6px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image { accessible-role: none; width: root.icon-size; height: root.icon-size; source: root.icon; colorize: label.color; }
        }
        label := Text {
            text: root.text; vertical-alignment: center;
            color: root.kind == ButtonKind.danger || root.kind == ButtonKind.primary ? white
                : root.kind == ButtonKind.row ? Pneu.danger
                : root.kind == ButtonKind.tonal ? Pneu.on-accent-soft
                : root.is-link ? Pneu.accent-text : Pneu.text;
            font-weight: root.is-row || root.is-link ? 600 : 400;
            overflow: elide;
        }
    }
    fs := FocusTarget {
        active: root.enabled && root.interactive;
        activate => { root.clicked(); }
    }
    touch := TouchArea {
        enabled: root.enabled && root.interactive;
        clicked => { fs.ring = false; fs.focus(); root.clicked(); }
    }
}

// Small square icon button, used for row actions (retry, cancel).
export component IconButton inherits Rectangle {
    in property <bool> dialog-control;
    private property <bool> interactive: !Interaction.modal-open || dialog-control;
    in property <bool> enabled: true;
    in property <image> icon;
    in property <string> label;
    callback clicked();
    width: 28px; height: 28px; border-radius: 7px;
    background: touch.pressed ? Pneu.pressed : touch.has-hover ? Pneu.hover : transparent;
    border-width: fs.ring ? 1px : 0px; border-color: Pneu.accent;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: root.enabled && root.interactive;
    accessible-action-default => { if root.enabled && root.interactive { root.clicked(); } }
    Image { accessible-role: none; x: 5px; y: 5px; width: 18px; height: 18px; source: root.icon; colorize: Pneu.text2; }
    fs := FocusTarget { active: root.enabled && root.interactive; activate => { if root.enabled && root.interactive { root.clicked(); } } }
    touch := TouchArea { enabled: root.enabled && root.interactive; clicked => { fs.ring = false; fs.focus(); root.clicked(); } }
}

export component Card inherits Rectangle {
    background: Pneu.card; border-radius: 14px;
    border-width: 1px; border-color: Pneu.card-border;
}

export component Row inherits HorizontalLayout {
    padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px;
    spacing: 12px;
}

export component Divider inherits Rectangle {
    in property <length> inset: 14px;
    height: 1px;
    Rectangle { x: root.inset; width: parent.width - root.inset - 14px; height: 1px; background: Pneu.card-border; }
}

export component SectionLabel inherits Text {
    font-size: Pneu.label-size; font-weight: 600; color: Pneu.text2;
    accessible-role: AccessibleRole.text;
}

// Device tile: indigo connected, amber paused, red pairing lost, grey otherwise.
export component Tile inherits Rectangle {
    in property <image> icon;
    in property <Tone> tone;
    in property <length> size: 36px;
    in property <length> icon-size: 20px;
    width: size; height: size;
    border-radius: size >= 40px ? 12px : 10px;
    background: tone == Tone.accent ? Pneu.accent-soft : tone == Tone.warn ? Pneu.warn-soft
        : tone == Tone.danger ? Pneu.danger-soft : Pneu.button;
    Image { accessible-role: none;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: root.icon-size; height: root.icon-size; source: root.icon;
        colorize: root.tone == Tone.accent ? Pneu.on-accent-soft : root.tone == Tone.warn ? Pneu.warn
            : root.tone == Tone.danger ? Pneu.danger : Pneu.text2;
    }
}

export component GhostTile inherits Rectangle {
    width: 36px; height: 36px;
    Image { accessible-role: none; source: Icons.ghost; width: 36px; height: 36px; colorize: Pneu.text2; }
    Image { accessible-role: none; x: 9px; y: 9px; width: 18px; height: 18px; source: Icons.add; colorize: Pneu.accent-text; }
}

export component PneuSpinner inherits Rectangle {
    in property <bool> motion;
    width: 30px; height: 30px; border-radius: 15px;
    border-width: 3px; border-color: Pneu.accent-soft;
    accessible-role: progress-indicator;
    Rectangle {
        transform-rotation: root.motion ? mod(animation-tick() / 800ms, 1) * 1turn : 0deg;
        Path {
            width: 30px; height: 30px; viewbox-width: 30; viewbox-height: 30;
            stroke: Pneu.accent; stroke-width: 3px; stroke-line-cap: round;
            commands: "M15 1.5 A13.5 13.5 0 0 1 28.5 15";
        }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value;
    height: 3px; border-radius: 1.5px; background: Pneu.card-border; clip: true;
    accessible-role: progress-indicator;
    accessible-value: round(value * 100) + "%";
    Rectangle { x: 0px; width: parent.width * clamp(root.value, 0, 1); height: 3px; border-radius: 1.5px; background: Pneu.accent; }
}

export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    width: 36px; height: 20px; border-radius: 10px;
    background: checked ? Pneu.accent : Pneu.switch-off;
    border-width: checked ? 0px : 1px;
    border-color: Pneu.switch-off-foreground;
    opacity: enabled ? 1 : 0.4;
    Rectangle {
        x: root.checked ? 18px : 4px; y: root.checked ? 2px : 4px;
        width: root.checked ? 16px : 12px; height: self.width; border-radius: self.width / 2;
        background: root.checked ? white : Pneu.switch-off-foreground;
        drop-shadow-blur: 2px; drop-shadow-offset-y: 1px; drop-shadow-color: root.checked ? #00000040 : transparent;
        animate x { duration: 120ms; easing: ease-out; }
    }
}

// A whole row toggles its switch, so the label is part of the target.
export component SwitchRow inherits Rectangle {
    in property <bool> dialog-control;
    private property <bool> interactive: !Interaction.modal-open || dialog-control;
    in property <string> label;
    in property <string> sub;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    min-height: 44px;
    accessible-role: switch;
    accessible-checked: checked;
    accessible-enabled: enabled && root.interactive;
    accessible-label: label;
    accessible-description: sub;
    accessible-action-default => { if root.enabled && root.interactive { root.toggled(!root.checked); } }
    forward-focus: fs;
    if fs.ring: Rectangle { border-radius: 4px; border-width: 1px; border-color: Pneu.accent; }
    Row {
        VerticalLayout {
            alignment: center; spacing: 1px;
            opacity: root.enabled ? 1 : 0.4;
            Text { text: root.label; color: Pneu.text; overflow: elide; }
            if root.sub != "": Text { text: root.sub; font-size: Pneu.label-size; color: Pneu.text2; wrap: word-wrap; }
        }
        VerticalLayout { alignment: center; Switch { checked: root.checked; enabled: root.enabled; } }
    }
    fs := FocusTarget {
        active: root.enabled && root.interactive;
        activate => { root.toggled(!root.checked); }
    }
    TouchArea {
        enabled: root.enabled && root.interactive;
        clicked => { fs.ring = false; fs.focus(); root.toggled(!root.checked); }
    }
}

export struct Segment { label: string, icon: image }

export component Segmented inherits Rectangle {
    in property <bool> dialog-control;
    private property <bool> interactive: !Interaction.modal-open || dialog-control;
    in property <[Segment]> items;
    in property <int> selected;
    in property <bool> enabled: true;
    callback select(int);
    height: 30px; border-radius: 8px;
    background: Pneu.button; border-width: 1px;
    border-color: fs.ring ? Pneu.accent : Pneu.button-border;
    opacity: enabled ? 1 : 0.4;
    accessible-role: tab-list;
    forward-focus: fs;
    fs := FocusTarget {
        active: root.enabled && root.interactive;
        key-pressed(event) => {
            if event.text == Key.LeftArrow && root.selected > 0 { root.select(root.selected - 1); return accept; }
            if event.text == Key.RightArrow && root.selected < root.items.length - 1 { root.select(root.selected + 1); return accept; }
            return reject;
        }
    }
    HorizontalLayout {
        padding: 2px; spacing: 2px;
        for item[i] in root.items: Rectangle {
            min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
            border-radius: 6px;
            background: i == root.selected ? Pneu.accent-soft : touch.has-hover ? Pneu.hover : transparent;
            accessible-role: tab;
            accessible-label: item.label;
            accessible-checked: i == root.selected;
            accessible-enabled: root.enabled && root.interactive;
            accessible-action-default => { if root.enabled && root.interactive { root.select(i); } }
            HorizontalLayout {
                alignment: center; spacing: 6px;
                if item.icon.width > 0: VerticalLayout {
                    alignment: center;
                    Image { accessible-role: none; width: 16px; height: 16px; source: item.icon; colorize: segment-text.color; }
                }
                segment-text := Text {
                    text: item.label; vertical-alignment: center;
                    color: i == root.selected ? Pneu.on-accent-soft : Pneu.text;
                    font-weight: i == root.selected ? 600 : 400;
                }
            }
            touch := TouchArea {
                enabled: root.enabled && root.interactive;
                clicked => { fs.ring = false; fs.focus(); root.select(i); }
            }
        }
    }
}

export component Checkbox inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    width: 18px; height: 18px; border-radius: 5px;
    background: checked ? Pneu.accent : Pneu.card;
    border-width: checked ? 0px : 1px; border-color: Pneu.button-border;
    opacity: enabled ? 1 : 0.4;
    if root.checked: Image { accessible-role: none; x: 2px; y: 2px; width: 14px; height: 14px; source: Icons.check; colorize: white; }
}

export component Header inherits HorizontalLayout {
    in property <bool> dialog-control;
    private property <bool> interactive: !Interaction.modal-open || dialog-control;
    in property <string> title;
    in property <bool> back: true;
    callback go-back();
    spacing: 4px;
    height: 30px;
    if root.back: Rectangle {
        width: 30px; height: 30px; border-radius: 8px;
        background: touch.pressed ? Pneu.pressed : touch.has-hover ? Pneu.hover : transparent;
        border-width: fs.ring ? 1px : 0px; border-color: Pneu.accent;
        accessible-role: button;
        accessible-label: "Back";
        accessible-enabled: root.interactive;
        accessible-action-default => { if root.interactive { root.go-back(); } }
        Image { accessible-role: none; x: 5px; y: 5px; width: 20px; height: 20px; source: Icons.chevron-left; colorize: Pneu.text; }
        fs := FocusTarget { active: root.interactive; activate => { root.go-back(); } }
        touch := TouchArea { enabled: root.interactive; clicked => { fs.ring = false; root.go-back(); } }
    }
    Text {
        text: root.title; font-size: Pneu.title-size; font-weight: 700; color: Pneu.text;
        vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
        accessible-role: AccessibleRole.text;
    }
}

// A card row which opens something: tile or icon, text, chevron.
export component NavRow inherits Rectangle {
    in property <bool> dialog-control;
    private property <bool> interactive: !Interaction.modal-open || dialog-control;
    in property <bool> enabled: true;
    in property <bool> highlighted;
    callback clicked();
    accessible-enabled: root.enabled && root.interactive;
    accessible-role: button;
    accessible-action-default => { if root.enabled && root.interactive { root.clicked(); } }
    forward-focus: fs;
    background: highlighted ? Pneu.button : touch.pressed ? Pneu.pressed : touch.has-hover && enabled ? Pneu.hover : transparent;
    if fs.ring: Rectangle { border-radius: 4px; border-width: 1px; border-color: Pneu.accent; }
    fs := FocusTarget { active: root.enabled && root.interactive; activate => { root.clicked(); } }
    touch := TouchArea { enabled: root.enabled && root.interactive; clicked => { fs.ring = false; fs.focus(); root.clicked(); } }
    @children
}

export component QrCard inherits Rectangle {
    in property <image> qr;
    width: qr.width * 1px + 28px; height: qr.height * 1px + 28px;
    border-radius: 16px; background: white;
    border-width: Pneu.dark ? 1px : 0px; border-color: #FFFFFF0F;
    drop-shadow-blur: Pneu.dark ? 0px : 12px; drop-shadow-offset-y: 3px; drop-shadow-color: #14161A0D;
    accessible-role: image;
    accessible-label: "Pairing QR code";
    Image { accessible-role: none; x: 14px; y: 14px; source: root.qr; width: root.qr.width * 1px; height: root.qr.height * 1px; image-rendering: pixelated; }
}

// The download page's code in the pairing code's card, so the two can swap in
// place. Its image has one pixel per module and scales by whole pixels; Pneu's
// icon covers the middle, which the code's high error correction allows for.
export component DownloadQrCard inherits Rectangle {
    in property <image> qr;
    in property <length> size;
    private property <length> module: qr.width > 0 ? floor(size / 1px / qr.width) * 1px : 0px;
    width: size + 28px; height: size + 28px;
    border-radius: 16px; background: white;
    border-width: Pneu.dark ? 1px : 0px; border-color: #FFFFFF0F;
    drop-shadow-blur: Pneu.dark ? 0px : 12px; drop-shadow-offset-y: 3px; drop-shadow-color: #14161A0D;
    accessible-role: image;
    accessible-label: "QR code for the Pneu download page";
    Image { accessible-role: none;
        width: root.module * root.qr.width; height: self.width;
        x: floor((parent.width - self.width) / 2px) * 1px; y: self.x;
        source: root.qr; image-rendering: pixelated;
    }
    Rectangle {
        width: 60px; height: 60px; border-radius: 16px; background: white;
        x: (parent.width - self.width) / 2; y: self.x;
        Image { accessible-role: none; x: 4px; y: 4px; width: 52px; height: 52px; source: Icons.pneu; }
    }
}

// Outlined single-line field for the rename popup.
export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <bool> autofocus;
    in property <string> label;
    callback accepted();
    height: 34px; border-radius: 8px;
    background: Pneu.card;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Pneu.accent : Pneu.button-border;
    forward-focus: input;
    Timer {
        interval: 1ms; running: root.autofocus;
        triggered => { self.running = false; input.focus(); input.select-all(); }
    }
    input := TextInput {
        x: 10px; width: parent.width - 20px; height: parent.height;
        vertical-alignment: center; single-line: true;
        color: Pneu.text; selection-background-color: Pneu.accent-soft; selection-foreground-color: Pneu.text;
        accessible-role: text-input;
        accessible-label: root.label;
        accessible-description: root.text;
        accepted => { root.accepted(); }
    }
}
