// The Link: this computer on the left, the other devices on the right (one
// tile, or a stack of up to three), and a tube showing the overall state.
import { Pneu, Tone, Icons } from "theme.slint";

// dashed: none reachable (with a badge); idle: not linked yet (no badge).
export enum Tube { solid, march, dashed, idle, paused, broken }

// Stack tiles arrive back to front; slot 0 is the front (leftmost) tile.
export struct LinkTile { phone: bool, tone: Tone, more: int, slot: int }

export struct LinkState {
    self-tone: Tone,
    tiles: [LinkTile],
    slots: int,
    tube: Tube,
    // 0 idle, 1 sending (left to right), 2 receiving (right to left, nose first)
    capsule: int,
}

component Capsule inherits Rectangle {
    in-out property <float> travel: 0.5;
    in property <bool> reverse;
    in property <length> tube-width;
    width: 20px; height: 9px; border-radius: 4.5px;
    background: Pneu.accent;
    x: (tube-width - self.width) * travel;
    y: (3px - self.height) / 2;
    opacity: min(1, min(travel * 8, (1 - travel) * 8));
    Rectangle {
        x: root.reverse ? 0px : parent.width - 6px; width: 6px; height: parent.height;
        border-radius: 4.5px; background: #FFB547;
    }
}

component AnimatedCapsule inherits Capsule {
    travel: self.reverse ? 1 : 0;
    init => { self.travel = self.reverse ? 0 : 1; }
    animate travel { duration: 1400ms; easing: cubic-bezier(0.45, 0, 0.2, 1); iteration-count: -1; }
}

component Badge inherits Rectangle {
    in property <image> icon;
    in property <Tone> tone;
    width: 32px; height: 32px; border-radius: 16px;
    background: Pneu.card;
    Rectangle {
        x: 3px; y: 3px; width: 26px; height: 26px; border-radius: 13px;
        background: root.tone == Tone.warn ? Pneu.warn-soft : root.tone == Tone.danger ? Pneu.danger-soft : Pneu.card;
        border-width: root.tone == Tone.neutral ? 1.5px : 0px; border-color: Pneu.card-border;
        Image { accessible-role: none;
            x: 6px; y: 6px; width: 14px; height: 14px; source: root.icon;
            colorize: root.tone == Tone.warn ? Pneu.warn : root.tone == Tone.danger ? Pneu.danger : Pneu.text2;
        }
    }
}

component EndTile inherits Rectangle {
    in property <bool> phone;
    in property <Tone> tone;
    in property <int> more;
    in property <bool> ring;
    width: 40px; height: 40px; border-radius: 12px;
    if root.ring: Rectangle {
        x: -3px; y: -3px; width: 46px; height: 46px; border-radius: 15px; background: Pneu.card;
    }
    Rectangle {
        border-radius: 12px;
        background: root.tone == Tone.accent ? Pneu.accent-soft : root.tone == Tone.warn ? Pneu.warn-soft
            : root.tone == Tone.danger ? Pneu.danger-soft : Pneu.button;
        if root.more > 0: Text {
            text: "+" + root.more; font-weight: 700; font-size: 13px; color: Pneu.text2;
            horizontal-alignment: center; vertical-alignment: center;
        }
        if root.more == 0: Image { accessible-role: none;
            x: 9px; y: 9px; width: 22px; height: 22px;
            source: root.phone ? Icons.smartphone : Icons.computer;
            colorize: root.tone == Tone.accent ? Pneu.on-accent-soft : root.tone == Tone.warn ? Pneu.warn
                : root.tone == Tone.danger ? Pneu.danger : Pneu.text2;
        }
    }
}

export component Link inherits Rectangle {
    in property <LinkState> state;
    in property <bool> motion;
    private property <length> stack-width: 40px + 12px * max(0, state.slots - 1);
    height: 40px;
    // The title and detail under the Link say the same in words.
    accessible-role: none;
    EndTile { x: 0px; y: 0px; phone: false; tone: root.state.self-tone; }
    tube := Rectangle {
        x: 52px; y: (parent.height - self.height) / 2;
        width: parent.width - 52px - root.stack-width - 12px; height: 3px; border-radius: 1.5px;
        private property <bool> busy: root.state.capsule != 0 && root.state.tube == Tube.solid;
        background: root.state.tube == Tube.solid && !self.busy ? @linear-gradient(90deg, #7381FF 0%, #4F5BFF 100%)
            : root.state.tube == Tube.solid || root.state.tube == Tube.paused ? Pneu.card-border : transparent;
        if root.state.tube == Tube.dashed || root.state.tube == Tube.idle || root.state.tube == Tube.march: Rectangle {
            clip: true;
            private property <length> shift: root.state.tube == Tube.march && root.motion
                ? mod(animation-tick() / 800ms, 1) * 11px : 0px;
            for i in ceil(tube.width / 11px) + 1: Rectangle {
                x: i * 11px + parent.shift - (root.state.tube == Tube.march ? 11px : 0px);
                y: 0px; width: 5px; height: 3px;
                background: root.state.tube == Tube.march ? Pneu.text2 : Pneu.card-border;
                opacity: root.state.tube == Tube.march ? 0.7 : 1;
            }
        }
        if root.state.tube == Tube.broken: Rectangle {
            Rectangle { x: 0px; width: parent.width * 0.38; height: 3px; border-radius: 1.5px; background: Pneu.danger-soft; }
            Rectangle { x: parent.width * 0.62; width: parent.width * 0.38; height: 3px; border-radius: 1.5px; background: Pneu.danger-soft; }
        }
        if self.busy && root.motion: AnimatedCapsule { tube-width: tube.width; reverse: root.state.capsule == 2; }
        if self.busy && !root.motion: Capsule { tube-width: tube.width; reverse: root.state.capsule == 2; }
        if root.state.tube == Tube.dashed: Badge {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            icon: Icons.cloud-off; tone: Tone.neutral;
        }
        if root.state.tube == Tube.paused: Badge {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            icon: Icons.pause; tone: Tone.warn;
        }
        if root.state.tube == Tube.broken: Badge {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            icon: Icons.link-off; tone: Tone.danger;
        }
    }
    for tile in root.state.tiles: EndTile {
        x: root.width - root.stack-width + tile.slot * 12px; y: 0px;
        phone: tile.phone; tone: tile.tone; more: tile.more;
        ring: root.state.slots > 1;
    }
}
